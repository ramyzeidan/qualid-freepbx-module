; =============================================================================
; QUALI-D Remote Agent — PJSIP Trunk Template
; This file is a TEMPLATE. The actual file is generated by the FreePBX module
; and written to /etc/asterisk/pjsip_qualid.conf
; Variables: {{TRUNK_USER}}, {{TRUNK_PASS}}, {{CLOUD_SERVER}}, {{CLOUD_IP}}
;
; Transport: SIP/TCP on port 443 — bypasses ISP SIP port blocking (e.g. Egypt).
; Port 443 is always open as HTTPS. No outbound registration needed — Kamailio
; authenticates via proxy auth on each INVITE.
; =============================================================================

; TCP transport for outbound SIP to QUALI-D cloud relay
[QualidRemote_tcp_transport]
type=transport
protocol=tcp
bind=0.0.0.0

[QualidRemote_auth]
type=auth
auth_type=userpass
username={{TRUNK_USER}}
password={{TRUNK_PASS}}

[QualidRemote_aor]
type=aor
contact=sip:{{CLOUD_IP}}:443;transport=tcp

[QualidRemote_endpoint]
type=endpoint
transport=QualidRemote_tcp_transport
outbound_auth=QualidRemote_auth
aors=QualidRemote_aor
context=QualidRemote-inbound
disallow=all
allow=ulaw
allow=alaw
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
from_user={{TRUNK_USER}}
from_domain={{CLOUD_SERVER}}
