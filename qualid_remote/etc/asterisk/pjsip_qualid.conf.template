; =============================================================================
; QUALI-D Remote Agent — PJSIP Trunk Template
; This file is a TEMPLATE. The actual file is generated by the FreePBX module
; and written to /etc/asterisk/pjsip_qualid.conf
; Variables: {{TRUNK_USER}}, {{TRUNK_PASS}}, {{CLOUD_SERVER}}, {{CLOUD_IP}}
;
; Transport: SIP/TLS on port 443 — encrypts SIP payload so Egyptian ISP DPI
; cannot detect INVITE keyword. Plain TCP on 443 was still blocked by content
; inspection; TLS makes traffic look like HTTPS to DPI devices.
; verify_server=no / verify_client=no — Kamailio uses a self-signed cert.
; =============================================================================

; TLS transport for outbound SIP to QUALI-D cloud relay
[QualidRemote_tls_transport]
type=transport
protocol=tls
bind=0.0.0.0
verify_server=no
verify_client=no

[QualidRemote_auth]
type=auth
auth_type=userpass
username={{TRUNK_USER}}
password={{TRUNK_PASS}}

[QualidRemote_aor]
type=aor
contact=sip:{{CLOUD_IP}}:443;transport=tls

[QualidRemote_endpoint]
type=endpoint
transport=QualidRemote_tls_transport
outbound_auth=QualidRemote_auth
aors=QualidRemote_aor
context=QualidRemote-inbound
disallow=all
allow=ulaw
allow=alaw
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
from_user={{TRUNK_USER}}
from_domain={{CLOUD_SERVER}}
