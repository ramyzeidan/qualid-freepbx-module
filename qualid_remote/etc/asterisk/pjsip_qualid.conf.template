; =============================================================================
; QUALI-D Remote Agent — PJSIP Trunk Template
; This file is a TEMPLATE. The actual file is generated by the FreePBX module
; and written to /etc/asterisk/pjsip_qualid.conf
; Variables: {{SIP_DOMAIN}}, {{TRUNK_USER}}, {{TRUNK_PASS}}, {{CLOUD_SERVER}}
; =============================================================================

; WSS transport for the QUALI-D cloud tunnel
[qualid_wss_transport]
type=transport
protocol=wss
bind=0.0.0.0

; Outbound registration — FreePBX → QUALI-D cloud relay
[QualidRemote]
type=registration
transport=qualid_wss_transport
outbound_auth=QualidRemote_auth
server_uri=sip:{{CLOUD_SERVER}}:443;transport=wss
client_uri=sip:{{TRUNK_USER}}@{{SIP_DOMAIN}}
retry_interval=60
expiration=3600

[QualidRemote_auth]
type=auth
auth_type=userpass
username={{TRUNK_USER}}
password={{TRUNK_PASS}}

[QualidRemote_aor]
type=aor
contact=sip:{{CLOUD_SERVER}}:443;transport=wss

[QualidRemote_endpoint]
type=endpoint
transport=qualid_wss_transport
outbound_auth=QualidRemote_auth
aors=QualidRemote_aor
context=QualidRemote-inbound
disallow=all
allow=ulaw
allow=alaw
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
from_user={{TRUNK_USER}}
from_domain={{SIP_DOMAIN}}
