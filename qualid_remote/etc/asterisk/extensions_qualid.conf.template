; Inbound context — calls arriving from the QUALI-D cloud to this FreePBX
[QualidRemote-inbound]
exten => _.,1,NoOp(QUALI-D Remote Agent: inbound from ${CALLERID(all)})
 same => n,Goto(from-trunk,${EXTEN},1)

; Remote agent routing context
; Use this when dialling a remote agent from queues/ring groups:
;   DIAL(PJSIP/agent_42@{{SIP_DOMAIN}},QualidRemote_endpoint,60)
[qualid-remote-agents]
exten => _agent_.,1,NoOp(QUALI-D: routing call to remote agent ${EXTEN})
 same => n,Dial(PJSIP/${EXTEN}@{{SIP_DOMAIN}}&QualidRemote_endpoint,60,rU)
 same => n,Hangup()
