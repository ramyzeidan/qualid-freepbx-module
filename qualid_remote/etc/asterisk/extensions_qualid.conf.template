; Inbound context — calls arriving from the QUALI-D cloud to this FreePBX
[QualidRemote-inbound]
exten => _.,1,NoOp(QUALI-D Remote Agent inbound call from ${CALLERID(all)})
 same => n,Set(CALLERID(name)=${CALLERID(name)})
 same => n,Goto(from-trunk,${EXTEN},1)

; Remote agent routing context
; Use in Ring Groups / Queues:
;   Dial(PJSIP/<agent_code>@QualidRemote_endpoint,60,rU)
[qualid-remote-agents]
exten => _.,1,NoOp(Routing call to remote agent ${EXTEN})
 same => n,Dial(PJSIP/${EXTEN}@QualidRemote_endpoint,60,rU)
 same => n,Hangup()
